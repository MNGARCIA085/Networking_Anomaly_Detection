{
  "experiment": {
    "type": "ae"
  },
  "model": {
    "params": {
      "encoder_dims": [
        128,
        64,
        32,
        16
      ],
      "decoder_dims": [
        32,
        64,
        128
      ]
    }
  },
  "data": {
    "train_path": "data/arriba.csv",
    "val_path": "data/arriba.csv",
    "y_val_path": "data/arriba.csv",
    "test_path": "data/arriba.csv",
    "y_test_path": "data/arriba.csv",
    "windowing": {
      "enabled": true,
      "size": 1,
      "stride": 1
    }
  },
  "preprocessing": {
    "pointwise": {
      "imputation": {
        "enabled": false,
        "name": "simple",
        "params": {
          "strategy": "median"
        }
      },
      "scaler": {
        "enabled": true,
        "name": "standard",
        "params": {
          "with_mean": true,
          "with_std": true
        }
      },
      "transform": {
        "enabled": false,
        "name": "power",
        "params": {
          "method": "yeo-johnson",
          "standardize": false
        }
      }
    },
    "windowing": {
      "size": 3,
      "stride": 1
    },
    "temporal_prep": {
      "delta": {
        "enable": false,
        "name": "delta",
        "params": {
          "order": 1
        }
      },
      "rolling": {
        "enabled": false,
        "name": "rolling_stats",
        "params": {
          "window": 5
        }
      }
    }
  },
  "thresholding": {
    "name": "constrained_f1",
    "params": {
      "min_recall": 0.75
    }
  },
  "training": {
    "batch_size": 32,
    "epochs": 2,
    "type": "default",
    "optimizer": {
      "name": "adam",
      "params": {
        "lr": 0.001,
        "betas": [
          0.9,
          0.999
        ],
        "weight_decay": 0.0001
      }
    },
    "loss": {
      "name": "mse"
    },
    "callbacks": [
      {
        "name": "print_loss"
      },
      {
        "name": "early_stopping",
        "params": {
          "patience": 15,
          "monitor": "val_loss",
          "mode": "min"
        }
      },
      {
        "name": "checkpoint",
        "params": {
          "every_n_epochs": 10,
          "keep_last": 2,
          "save_best": true,
          "monitor": "val_loss",
          "mode": "min"
        }
      }
    ],
    "num_workers": 1
  }
}