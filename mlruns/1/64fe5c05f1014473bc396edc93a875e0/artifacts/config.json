{
  "experiment": {
    "type": "isoforest"
  },
  "model": {
    "params": {
      "n_estimators": 100,
      "contamination": 0.1,
      "max_samples": "auto",
      "max_features": 1.0,
      "bootstrap": false,
      "random_state": 42
    }
  },
  "data": {
    "train_path": "data/arriba.csv",
    "val_path": "data/arriba.csv",
    "y_val_path": "data/arriba.csv",
    "test_path": "data/arriba.csv",
    "y_test_path": "data/arriba.csv",
    "windowing": {
      "enabled": true,
      "size": 1,
      "stride": 1
    }
  },
  "preprocessing": {
    "pointwise": {
      "scaler": {
        "enable": true,
        "name": "standard",
        "params": {
          "with_mean": true,
          "with_std": true
        }
      },
      "feature_selection": {
        "enable": false,
        "name": "variance_threshold",
        "params": {
          "threshold": 0.01
        }
      },
      "dim_reduction": {
        "enable": true,
        "name": "pca",
        "params": {
          "n_components": 4,
          "whiten": false
        }
      },
      "transform": {
        "enable": false,
        "name": "power",
        "params": {
          "method": "yeo-johnson"
        }
      },
      "contamination_filter": {
        "enabled": false
      }
    },
    "windowing": {
      "size": 5,
      "stride": 1
    }
  },
  "thresholding": {},
  "training": {}
}